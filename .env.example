# ---------------------------------------------------------------------------
# Banco de dados — PostgreSQL (Supabase)
# ---------------------------------------------------------------------------
# Três conexões, três papéis. Ver server/docs/supabase-setup.md para o SQL que
# cria os roles e aplica as políticas de Row Level Security.

# Role `app_user` — usado por TODAS as queries de dados financeiros.
# NÃO pode ter BYPASSRLS: é isso que faz a RLS valer de verdade.
# Use a URI "Session pooler" (porta 5432) ou a conexão direta.
DATABASE_URL="postgresql://app_user:SENHA@HOST:5432/postgres?schema=public"

# Role owner — usado apenas por `prisma migrate` (DDL). Nunca em runtime.
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres?schema=public"

# Role `app_system` — acesso restrito a `users` e `password_reset_tokens`,
# necessário para login/registro (quando ainda não há usuário autenticado).
SYSTEM_DATABASE_URL="postgresql://app_system:SENHA@HOST:5432/postgres?schema=public"

# Banco usado por `npm test`. Aponta para um SCHEMA separado no mesmo projeto,
# então os testes nunca tocam nos seus dados de desenvolvimento.
TEST_DATABASE_URL="postgresql://postgres:SENHA@HOST:5432/postgres?schema=finance_test"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-por-um-segredo-forte-antes-de-usar-em-producao"
JWT_EXPIRES_IN="7d"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV="development"

# Limite de upload de extrato, em bytes (padrão 5 MB).
MAX_UPLOAD_BYTES=5242880
